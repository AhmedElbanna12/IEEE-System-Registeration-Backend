          "code": {
            "type": "string",
            "nullable": true
          },
          "discountPercentage": {
            "type": "integer",
            "format": "int32"
          },
          "usageLimit": {
            "type": "integer",
            "format": "int32"
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
