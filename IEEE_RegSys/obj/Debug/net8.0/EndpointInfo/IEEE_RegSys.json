                }
              },
              "encoding": {
                "FullNameArabic": {
                  "style": "form"
                },
                "FullNameEnglish": {
                  "style": "form"
                },
                "Phone": {
                  "style": "form"
                },
                "Governorate": {
                  "style": "form"
                },
                "NationalID": {
                  "style": "form"
                },
                "College": {
                  "style": "form"
                },
                "AcademicYear": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "Age": {
                  "style": "form"
                },
                "Gender": {
                  "style": "form"
                },
                "PaymentCode": {
                  "style": "form"
                },
                "PaymentImage": {
                  "style": "form"
                },
                "IsNeedBus": {
                  "style": "form"
                },
                "ISIEEEIAN": {
                  "style": "form"
                },
                "PromoCode": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
